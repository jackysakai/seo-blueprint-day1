# Copy this file to .env and fill in what you have. Commands tell you when one is needed.
# .env is gitignored. Never commit it, never paste a key into a chat or a page.

# ── Research + data ──
# Apify - /context-layer's social sweep, /gbp-posts' Reddit scrape, /proposal's GBP + review pull.
# Free tier works. apify.com
APIFY_TOKEN=
# DataForSEO - /proposal's SERP, backlink, domain rank and local pack data.
# dataforseo.com > sign up (free $1 credit, no card) > dashboard > API Access.
# The second one is a PASSWORD, not an API key - name it exactly as below.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Pexels - /build-website's stock photos when context/proof/images/ is empty.
# Free, no card: pexels.com/api. Falls back to Openverse without it.
PEXELS_API_KEY=
# Google Search Console service account - /gsc walks you through creating it.
GSC_KEY_FILE=gsc-key.json

# ── Leads ──
# Where the contact + quote forms post. GHL > Automation > Workflows > Inbound Webhook.
# Until this is set, the forms error.
LEAD_WEBHOOK_URL=


# ── Supabase - proposal database. Three keys, two dashboard pages. ──
# Create the project first at supabase.com > New project (free tier is plenty).
# Settings > Database > Connection string > URI (Session pooler). Paste it whole -
# it already contains your project ref, host and password. This creates the tables.
SUPABASE_DB_URL=
# Settings > API. SERVICE_ROLE is server-only - never give it a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# ── In-house AI chatbot (replaces Elfsight) ──
# OFF until website/lib/site.config.ts chatbot.enabled is true. Get the key at
# console.anthropic.com > API Keys, set a monthly spend limit under Billing,
# then add it in the Vercel project (Settings > Environment Variables), NOT here.
# Model used: Claude Haiku 4.5 (~a fraction of a cent per message).
ANTHROPIC_API_KEY=

# Where a copy of every chatbot conversation is emailed. Set this to a Make.com
# (or Zapier / Google Apps Script) "Webhook -> Send email" URL. The site POSTs
# JSON { to, subject, text, messages, ... }; the scenario just emails `text` to
# `to`. Empty = no email is sent, the chat still works. Add it in the Vercel
# project (Settings > Environment Variables), NOT here.
CHAT_LOG_WEBHOOK=
